<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>在对话中拍照，确认后加入草稿；发送时才交给模型。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>当你点保存图片时，将 Melo 的图片添加到照片。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>点击语音输入时使用麦克风，将说话内容转为可编辑文字；由你确认后发送。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>将语音识别为输入框中的文字，或把你选择的视频中的语音转成文字稿；识别服务可能需要联网。</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>在你开启“日历”后，Melo 读取日程来回答你的问题；新建日程前会请你确认。</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>在你开启“提醒事项”后，Melo 读取提醒；新建或完成提醒前会请你确认。</string>
	<key>NSContactsUsageDescription</key>
	<string>在你开启“通讯录”后，Melo 按姓名查找联系人的电话和邮箱。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>在你开启“当前位置”并提问需要时，Melo 读取一次大致位置。</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array><string>$(PRODUCT_BUNDLE_IDENTIFIER).reply.*</string></array>
	<key>UIBackgroundModes</key>
	<array><string>processing</string></array>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>Icon-60</string>
			</array>
			<key>UIPrerenderedIcon</key>
			<true/>
		</dict>
	</dict>
</dict>
</plist>
