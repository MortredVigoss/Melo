{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "未找到这张图片的可信保存记录。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到这张图片的可信保存记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trusted saved record was found for this image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像の信頼できる保存記録が見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지의 신뢰할 수 있는 저장 기록을 찾을 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró un registro guardado fiable de esta imagen."
          }
        }
      }
    },
    "图片位置不在已登记的工作目录内。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片位置不在已登记的工作目录内。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is outside its registered workspace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像は登録された作業フォルダの外にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 등록된 작업 폴더 밖에 있습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen está fuera de su carpeta de trabajo registrada."
          }
        }
      }
    },
    "图片原文件已不存在。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片原文件已不存在。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original image file no longer exists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の画像ファイルが見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 이미지 파일이 더 이상 존재하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de imagen original ya no existe."
          }
        }
      }
    },
    "图片工作目录已变化，无法安全打开。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片工作目录已变化，无法安全打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image workspace has changed and cannot be opened safely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の作業フォルダが変更されたため、安全に開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 작업 폴더가 변경되어 안전하게 열 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de la imagen ha cambiado y no se puede abrir de forma segura."
          }
        }
      }
    },
    "图片路径包含软链接，无法安全打开。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片路径包含软链接，无法安全打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image path contains a symbolic link and cannot be opened safely."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像パスにシンボリックリンクが含まれるため、安全に開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 경로에 심볼릭 링크가 있어 안전하게 열 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta contiene un enlace simbólico y no se puede abrir de forma segura."
          }
        }
      }
    },
    "图片位置不是普通文件。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片位置不是普通文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image location is not a regular file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の場所は通常のファイルではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 위치가 일반 파일이 아닙니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación de la imagen no es un archivo normal."
          }
        }
      }
    },
    "图片文件已损坏，无法读取。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片文件已损坏，无法读取。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image file is damaged and cannot be read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像ファイルが破損しているため、読み込めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 파일이 손상되어 읽을 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen está dañada y no se puede leer."
          }
        }
      }
    },
    "图片文件已损坏或格式不受支持。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片文件已损坏或格式不受支持。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is damaged or its format is unsupported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が破損しているか、形式が対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 손상되었거나 지원하지 않는 형식입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen está dañada o su formato no es compatible."
          }
        }
      }
    },
    "图片格式不受支持。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片格式不受支持。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image format is unsupported."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像形式には対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원하지 않는 이미지 형식입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de imagen no es compatible."
          }
        }
      }
    },
    "图片超过 64 MB，暂时无法打开。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片超过 64 MB，暂时无法打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images larger than 64 MB cannot be opened yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "64 MB を超える画像は現在開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "64 MB를 초과하는 이미지는 아직 열 수 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se pueden abrir imágenes de más de 64 MB."
          }
        }
      }
    },
    "图片暂时无法读取，请重试。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片暂时无法读取，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image could not be read. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を読み込めません。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 읽을 수 없습니다. 다시 시도하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la imagen. Inténtalo de nuevo."
          }
        }
      }
    },
    "图片访问地址无效。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片访问地址无效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image access address is invalid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像のアクセス先が無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 접근 주소가 유효하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección de acceso a la imagen no es válida."
          }
        }
      }
    },
    "图片已损坏或浏览器不支持此格式。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片已损坏或浏览器不支持此格式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is damaged or this browser does not support its format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が破損しているか、このブラウザで形式に対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 손상되었거나 브라우저에서 지원하지 않는 형식입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen está dañada o el navegador no admite su formato."
          }
        }
      }
    },
    "已保存，等待刷新页面": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存，等待刷新页面"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Waiting to refresh the page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みです。ページの更新をお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되었습니다. 페이지 새로 고침을 기다리는 중입니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Pendiente de actualizar la página."
          }
        }
      }
    },
    "刷新只读取已保存的内容。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刷新只读取已保存的内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refreshing only reads the saved content."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新では保存済みの内容のみを読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 고침은 저장된 내용만 읽습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al actualizar solo se lee el contenido guardado."
          }
        }
      }
    },
    "正在刷新…": {
      "extractionState": "manual",
