    "项目已删除；聊天、资料、图片和原文件夹保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目已删除；聊天、资料、图片和原文件夹保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project deleted. Chats, knowledge, images and the original folder are retained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトは削除済みです。会話・資料・画像・元のフォルダは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트가 삭제되었습니다. 대화, 자료, 이미지와 원래 폴더는 보존됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyecto eliminado. Se conservan los chats, documentos, imágenes y la carpeta original."
          }
        }
      }
    },
    "原项目记忆保留在旧范围，旧审批不会恢复。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原项目记忆保留在旧范围，旧审批不会恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project memories remain in their original scope. Old approvals are not restored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶は元の範囲に保持され、以前の承認は復元されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억은 원래 범위에 보존되며 이전 승인은 복원되지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recuerdos conservan su ámbito original. No se restauran las aprobaciones anteriores."
          }
        }
      }
    },
    "聊天将解除项目归属，资料、图片与外部文件夹保留；项目记忆隔离保存，待审批失效。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天将解除项目归属，资料、图片与外部文件夹保留；项目记忆隔离保存，待审批失效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats will be detached. Knowledge, images and external folders are retained; project memories stay isolated and pending approvals become invalid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の所属を解除します。資料・画像・外部フォルダは保持し、記憶は分離保存、未処理の承認は無効化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화의 프로젝트 연결을 해제합니다. 자료, 이미지, 외부 폴더는 보존하고 프로젝트 기억은 분리하며 대기 중 승인은 무효화합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desvincularán los chats. Se conservan documentos, imágenes y carpetas externas; los recuerdos quedan aislados y las aprobaciones pendientes se invalidan."
          }
        }
      }
    },
    "请等待项目中的任务结束后再删除。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待项目中的任务结束后再删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the project tasks to finish before deleting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトのタスク終了後に削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 작업이 끝난 후 삭제하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera a que terminen las tareas del proyecto antes de eliminarlo."
          }
        }
      }
    },
    "项目已删除，请从删除记录恢复。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目已删除，请从删除记录恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project deleted. Restore it from deleted projects."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除済みプロジェクトから復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 프로젝트 목록에서 복원하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el proyecto desde los proyectos eliminados."
          }
        }
      }
    },
    "项目删除同步等待当前任务结束，现有执行保持不变。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
