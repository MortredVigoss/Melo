          "stringUnit": {
            "state": "translated",
            "value": "確認した写真を下書きに追加します。送信するまでモデルには渡されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인한 사진은 초안에 추가되며 전송을 눌러야 모델에 전달됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos confirmadas se añaden al borrador. Solo se envían al modelo cuando pulsas Enviar."
          }
        }
      }
    }
  },
  "version": "1.0"
}
