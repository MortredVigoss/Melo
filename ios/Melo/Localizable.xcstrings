    "查看日程；新建日程前会请你确认。包括已添加到 iPhone 的 Google、iCloud 等日历。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看日程；新建日程前会请你确认。包括已添加到 iPhone 的 Google、iCloud 等日历。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View events; asks before creating one. Includes Google, iCloud and other calendars added to this iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を表示します。作成前に確認します。iPhone に追加した Google や iCloud などのカレンダーを含みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정을 확인합니다. 새 일정 생성 전 확인합니다. iPhone에 추가된 Google, iCloud 등 캘린더를 포함합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver eventos; pregunta antes de crear uno. Incluye Google, iCloud y otros calendarios añadidos al iPhone."
          }
        }
      }
    },
    "查看提醒；新建或完成提醒前会请你确认。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看提醒；新建或完成提醒前会请你确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View reminders; asks before creating or completing one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーを表示します。作成や完了の前に確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 알림을 확인합니다. 생성하거나 완료하기 전 확인합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver recordatorios; pregunta antes de crear o completar uno."
          }
        }
      }
    },
    "按姓名查找联系人的电话、邮箱和公司。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按姓名查找联系人的电话、邮箱和公司。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find a contact's phone, email and company by name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前から連絡先の電話番号、メール、会社を探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름으로 연락처의 전화번호, 이메일, 회사를 찾습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca por nombre el teléfono, correo y empresa de un contacto."
          }
        }
      }
    },
    "需要时读取一次当前位置，用于“附近”“我在哪”这类问题。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要时读取一次当前位置，用于“附近”“我在哪”这类问题。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads your location once when needed, for questions like “nearby” or “where am I”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なときに一度だけ現在地を読み取り、「近く」「今どこ」などの質問に使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요할 때 한 번 현재 위치를 읽어 '근처', '여기가 어디' 같은 질문에 사용합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee tu ubicación una vez cuando hace falta, para preguntas como «cerca» o «dónde estoy»."
          }
        }
      }
    },
    "iOS 未授予%@权限。可在 iPhone 设置中允许 Melo 后再开启。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 未授予%@权限。可在 iPhone 设置中允许 Melo 后再开启。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS did not grant %@ access. Allow Melo in iPhone Settings, then turn this on again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS が %@ へのアクセスを許可していません。iPhone の設定で Melo を許可してから再度オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 %@ 권한을 허용하지 않았습니다. iPhone 설정에서 Melo를 허용한 후 다시 켜세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no concedió acceso a %@. Permite Melo en Ajustes del iPhone y vuelve a activarlo."
          }
        }
      }
    },
