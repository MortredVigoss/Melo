    "资料由你保存并选用；记忆自动召回；技能提供工作方法。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料由你保存并选用；记忆自动召回；技能提供工作方法。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your resources, recall memories and apply reusable skills."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資料を選び、記憶を呼び出し、スキルを活用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
