    },
    "请求生成中的预览（可能增加用量；通道需支持流式图像）": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求生成中的预览（可能增加用量；通道需支持流式图像）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request generation previews (may increase usage; requires image streaming support)"
