          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Merging keeps your edits and updates unedited fields. Review before saving."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統合で自分の編集を保持し、未編集の項目を更新します。確認して保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합 시 내 수정은 유지하고 다른 필드는 갱신합니다. 확인 후 저장하세요."
          }
        },
        "es": {
          "stringUnit": {
