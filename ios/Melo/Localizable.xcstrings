          }
        }
      }
    },
    "资料按问题与上下文预算选取相关片段，全文保留。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料按问题与上下文预算选取相关片段，全文保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Relevant excerpts are selected for the question and context budget; full documents are retained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問とコンテキスト予算に合わせて関連箇所を選び、原文は保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문과 문맥 한도에 맞는 부분을 선택하며 원문은 보존됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eligen fragmentos relevantes según la pregunta y el contexto disponible; se conservan los documentos completos."
          }
        }
      }
    },
