        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예: 결론을 먼저 말하고 간단히 설명하며 불확실한 점은 명확히 밝히기."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo: empieza con la respuesta, explica brevemente e indica las dudas."
