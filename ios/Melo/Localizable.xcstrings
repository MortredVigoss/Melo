    "切换只影响之后的回复；历史消息保持原Agent。": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换只影响之后的回复；历史消息保持原Agent。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching affects future replies only; past messages keep their agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は次の返信から適用されます。過去のメッセージの担当は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경은 이후 응답에만 적용됩니다. 이전 메시지의 에이전트는 유지됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio solo afecta a respuestas futuras; los mensajes anteriores conservan su agente."
          }
        }
