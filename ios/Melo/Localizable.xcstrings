      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：先给结论，用两三句短句解释；不确定时明确说明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: lead with the answer, explain briefly, and state uncertainty."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：結論を先に簡潔に説明し、不確実な点を明記する。"
