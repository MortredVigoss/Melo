          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトと会話の資料を合わせて送信します。重複除去後、最大8件・合計24,000文字です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
