            "state": "translated",
            "value": "模型地址、密钥和登录授权在模型连接中统一管理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage model endpoints, keys and sign-in authorization together in Model connections."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
