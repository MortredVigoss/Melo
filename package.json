{
  "name": "melo-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "melo": "./src/index.js"
  },
  "scripts": {
    "build": "node scripts/check-syntax.js",
    "build:native": "node-gyp rebuild",
    "build:desktop": "zsh scripts/build-desktop-app.sh",
    "install:desktop": "zsh scripts/install-desktop-app.sh",
    "test": "node scripts/verify-red-green.js",
    "verify:red-green": "node scripts/verify-red-green.js",
    "progress:codex": "node scripts/sync-codex-progress.js",
    "start": "node src/index.js",
    "doctor": "node src/index.js doctor",
    "chat": "node src/index.js chat",
    "rebuild:voice": "npm rebuild @discordjs/opus",
    "bench:memory": "node scripts/bench-memory.js",
    "test:ui": "node --test 'desktop-ui/**/*.test.js'",
    "test:scripts": "node --test 'scripts/**/*.test.js'",
    "test:server-guard": "node --test src/serverGuard.test.js",
    "test:tts": "node --test src/services/tts/nativeSayQueue.test.js src/services/tts/nativeStopEndpointsGuard.test.js",
    "test:markdown-files": "node --test src/services/agent/markdownFiles.test.js",
    "test:external-readers": "node --test src/web/externalReaders.test.js",
    "test:tools-evidence-trail": "node --test src/tools/executor.evidenceTrail.test.js src/tools/parser.evidenceTrail.test.js",
    "test:api-direct": "node --test src/services/search/apiDirect.test.js",
    "test:search-task": "node --test src/services/search/searchTask.test.js",
    "test:melo-chrome": "node --test src/services/browser/meloChrome.test.js",
    "test:browser-connect": "node --test src/services/browser/connect.test.js",
    "test:fetchurl-cdp": "node --test src/tools/builtins/fetchUrlTool.cdpChrome.test.js",
    "test:websearch-cdp": "node --test src/tools/builtins/webSearchTool.cdpChrome.test.js",
    "test:websearch-swr-abort": "node --test src/tools/builtins/webSearchTool.swrAbort.test.js",
    "test:websearch-api-direct": "node --test src/tools/builtins/webSearchTool.apiDirect.test.js",
    "test:websearch-jina-abort": "node --test src/tools/builtins/webSearchTool.jinaAbort.test.js",
    "test:cross-home": "node --test src/tools/builtins/webSearchTool.crossHome.test.js src/agents/skillRuns.crossHome.test.js src/memory/conversationIndex.crossHome.test.js",
    "test:evidence-trail-tools": "node --test src/tools/builtins/webSearchTool.evidenceTrail.test.js src/tools/builtins/fetchUrlTool.evidenceTrail.test.js src/tools/builtins/socialLinkTool.evidenceTrail.test.js",
    "test:page-registry": "node --test src/services/browser/pageRegistry.test.js src/services/browser/pageRegistry.shutdownWire.test.js",
    "test:browser-tools": "node --test src/tools/builtins/browserTools.test.js",
    "test:state-hydration": "node --test src/state/stateHydration.test.js src/state/stateSelections.customizeSection.test.js",
    "test:tool-result-projection": "node --test src/services/chat/toolResultProjection.test.js",
    "test:tool-consistency": "node --test src/tools/registry.consistency.test.js",
    "postinstall": "node-gyp rebuild"
  },
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "@mozilla/readability": "^0.5.0",
    "@vscode/ripgrep": "^1.17.1",
    "discord.js": "^14.16.3",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "jsdom": "^25.0.1",
    "node-addon-api": "^8.3.0",
    "node-gyp": "^11.0.0",
    "opusscript": "^0.0.8",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.15.0",
    "playwright-core": "^1.60.0",
    "prism-media": "^1.3.5",
    "sharp": "^0.34.5",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^5.1.1",
    "three": "^0.184.0",
    "tweetnacl": "^1.0.3"
  }
}
