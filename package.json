    "rebuild:voice": "npm rebuild @discordjs/opus",
    "bench:memory": "node scripts/bench-memory.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "@mozilla/readability": "^0.5.0",
    "@vscode/ripgrep": "^1.17.1",
    "discord.js": "^14.16.3",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "jsdom": "^25.0.1",
    "opusscript": "^0.0.8",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.15.0",
    "prism-media": "^1.3.5",
    "sharp": "^0.34.5",
    "sqlite-vec": "^0.1.9",
    "tesseract.js": "^5.1.1",
    "three": "^0.184.0",
    "tweetnacl": "^1.0.3"
