[
  {
    "name": "plain chat does not touch network or screen",
    "ok": true,
    "input": {
      "version": 1,
      "op": "plan",
      "request": {
        "text": "1+1",
        "capabilities": {
          "executors": [
            "web_search",
            "fetch_url",
            "phone_use"
          ],
          "grants": [
            "web_search",
            "fetch_url",
            "phone_use"
          ],
          "hostedSearch": "unknown"
        },
        "config": {}
      }
    },
    "expected": {
      "route": "none",
      "tools": []
    }
  },
  {
    "name": "unknown hosted support never implies web search",
    "ok": true,
    "input": {
      "version": 1,
      "op": "plan",
      "request": {
        "text": "Surry Hills 有什么好吃的餐厅",
        "capabilities": {
          "executors": [
            "web_search",
            "fetch_url",
            "phone_use"
          ],
          "grants": [
            "web_search",
            "fetch_url",
            "phone_use"
          ],
          "hostedSearch": "unknown"
        },
        "config": {}
      }
    },
    "expected": {
      "route": "unavailable",
      "reason": "SEARCH_UNAVAILABLE",
      "tools": []
    }
  },
  {
