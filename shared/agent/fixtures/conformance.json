  {
    "name": "reused call ID across rounds",
    "input": {
      "version": 1,
      "op": "advance",
      "state": {
        "version": 1,
        "runId": "run-a",
        "turnId": "turn-a",
        "status": "running",
        "startedAt": 1000,
        "lastNow": 1000,
        "deadline": 2000,
        "limits": {
          "rounds": 3,
          "callsPerRound": 2,
          "errors": 3,
          "stagnant": 5
        },
        "allowedTools": [
          "read"
        ],
        "rounds": 1,
        "awaitingModel": true,
        "callIds": [
          "previous"
        ],
        "pending": [],
        "permitted": [],
        "errors": 0,
        "roundSucceeded": false,
        "stagnant": 0,
        "progressKeys": [],
        "reason": null
      },
      "event": {
        "runId": "run-a",
        "turnId": "turn-a",
        "type": "calls",
        "calls": [
          {
            "id": "previous",
            "name": "read"
          }
        ]
      },
      "now": 1000
    },
    "ok": false,
    "expected": {
      "code": "DUPLICATE_CALL_ID"
    }
  },
