[
  {
    "name": "plain chat does not touch network or screen",
    "ok": true,
    "input": {
      "version": 1,
      "op": "plan",
      "request": {
        "text": "1+1",
        "capabilities": {
          "executors": [
            "web_search",
            "fetch_url",
            "phone_use"
          ],
          "grants": [
            "web_search",
            "fetch_url",
            "phone_use"
          ],
          "hostedSearch": "unknown"
        },
        "config": {}
      }
    },
    "expected": {
      "route": "none",
      "tools": []
    }
  },
