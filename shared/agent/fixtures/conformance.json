    }
  },
  {
    "name": "configured HTTP search uses a function tool",
    "ok": true,
    "input": {
      "version": 1,
      "op": "plan",
      "request": {
        "text": "搜索 Surry Hills 餐厅",
        "capabilities": {
          "executors": [
            "web_search",
            "fetch_url",
            "phone_use"
          ],
          "grants": [
            "web_search",
            "fetch_url",
            "phone_use"
          ],
          "hostedSearch": "unknown"
        },
        "config": {
          "search": {
            "backend": "http",
            "endpoint": "https://fixture.invalid/search"
          }
        }
      }
    },
    "expected": {
      "route": "http-search",
      "tools": [
        "web_search"
      ]
    }
  },
